    <!-- Custom target to copy Includes directory from build output to publish directory. So the csv files from the controlledVocabularies package are also present-->
    <Target Name="CopyIncludesToPublish" AfterTargets="Publish">
        <ItemGroup>
            <IncludesFromOutput Include="$(OutputPath)Includes\**\*.*" />
        </ItemGroup>
        <Message Importance="high" Text="Copying Includes directory with @(IncludesFromOutput-&gt;Count()) files to publish directory" />
        <Copy SourceFiles="@(IncludesFromOutput)" DestinationFiles="@(IncludesFromOutput->'$(PublishDir)Includes\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
        <Message Importance="high" Text="Finished copying Includes to $(PublishDir)Includes\" />
    </Target>
    
